#### crowsnest.conf — Voron 2.4 Gr1mSkull (1× USB camera, обзор корпуса)
#### Скопировать: ~/printer_data/config/crowsnest.conf
#### Замените device: на вывод: ls -la /dev/v4l/by-id/*-video-index0

[crowsnest]
log_path: %%LOGPATH%%
log_level: verbose
delete_log: false
no_proxy: false

#####################################################################
# Камера — обзор корпуса (GEMBIRD / Generic USB2.0 PC CAMERA, 1908:2311)
# Mainsail: /webcam/?action=stream
#####################################################################

[cam chamber]
port: 8080
device: /dev/v4l/by-id/usb-Generic_USB2.0_PC_CAMERA-video-index0
resolution: 1280x720
max_fps: 15
# Если чёрный экран — смените mode (см. doc/cameras_setup.md):
mode: ustreamer
# mode: camera-streamer
#custom_flags:
#v4l2ctl:

# Вторую камеру (сопло) НЕ добавляйте, если USB-камеры нет —
# лишний блок [cam nozzle] ломает Crowsnest или даёт 404 на /webcam2/
